# Конфиг quiz-api («Вброс по борту»). Реальный файл: /opt/quiz-api/.env на tgbsrv.
# Значения — из приложения на https://oauth.yandex.ru (не коммитить!)
YANDEX_CLIENT_ID=ВСТАВИТЬ_CLIENT_ID
YANDEX_CLIENT_SECRET=ВСТАВИТЬ_CLIENT_SECRET
SITE_URL=https://sport.tgbsrv.ru
BASE_URL=/referee/api
DATABASE_URL=postgresql://quiz:ВСТАВИТЬ_ПАРОЛЬ@127.0.0.1:5434/quiz
VOTE_THRESHOLD=5
# id пользователей-админов (редактор вопросов quiz/edit.html), через запятую
ADMIN_IDS=1
